SubDir HAIKU_TOP src system kernel arch mips ;

UsePrivateHeaders [ FDirName graphics newport ] ;

UsePrivateKernelHeaders ;

SEARCH_SOURCE += [ FDirName $(SUBDIR) $(DOTDOT) generic ] ;

KernelMergeObject kernel_arch_mips.o :
	arch_asm.S
	arch_exceptions.S
	arch_fpu.S
	arch_tlb.S
	arch_commpage.cpp
	arch_cpu.cpp
	arch_debug.cpp
	arch_debug_console.cpp
	arch_newport_console.cpp
	arch_debug_net.cpp
	arch_elf.cpp
	arch_int.cpp
	arch_platform.cpp
	arch_real_time_clock.cpp
	arch_smp.cpp
	arch_system_info.cpp
	arch_thread.cpp
	arch_timer.cpp
	arch_user_debugger.cpp
	arch_vm.cpp
	arch_vm_translation_map.cpp
	# the pci bus manager links against these
	generic_msi.cpp
	MIPSVMTranslationMap.cpp
	:
	$(TARGET_KERNEL_PIC_CCFLAGS) -Wno-unused
	:
;

# syscall_numbers.h is generated on the fly, so we need a explicit dependency.
Includes [ FGristFiles arch_commpage.cpp arch_int.cpp ]
	: <syscalls!$(TARGET_PACKAGING_ARCH)>syscall_numbers.h ;
